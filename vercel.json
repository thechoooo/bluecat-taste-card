{
  "redirects": [
    {
      "source": "/:path(dinner|d|dinner\\.html)",
      "has": [{ "type": "host", "value": "bluecat-taste-card-two\\.vercel\\.app" }],
      "destination": "https://bluecat-yearend.vercel.app/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "bluecat-yearend\\.vercel\\.app" }],
      "destination": "/dinner.html"
    },
    { "source": "/dinner", "destination": "/dinner.html" },
    { "source": "/d", "destination": "/dinner.html" }
  ]
}

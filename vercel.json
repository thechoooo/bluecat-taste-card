{
  "routes": [
    {
      "src": "^/(dinner|d|dinner\\.html)$",
      "has": [{ "type": "host", "value": "bluecat-taste-card-two.vercel.app" }],
      "status": 307,
      "headers": { "Location": "https://bluecat-yearend.vercel.app/" }
    },
    {
      "src": "^/$",
      "has": [{ "type": "host", "value": "bluecat-yearend.vercel.app" }],
      "dest": "/dinner.html"
    },
    { "src": "^/(dinner|d)$", "dest": "/dinner.html" }
  ]
}
